# Postgres (used by docker-compose and apps/api)
POSTGRES_USER=oboishop
POSTGRES_PASSWORD=oboishop_dev_password
POSTGRES_DB=oboishop_sklad
# 5544, not 5432 — avoids clashing with a pre-existing local Postgres install
# (and other docker containers already using 5433) on this machine. Pick any
# free port if 5544 is taken on yours.
POSTGRES_PORT=5544

DATABASE_URL="postgresql://oboishop:oboishop_dev_password@localhost:5544/oboishop_sklad?schema=public"

# apps/api
API_PORT=4000
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="12h"

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# apps/api — ilova ichidagi bildirishnoma (qo'ng'iroq belgisi). Kontragent
# (mijoz/yetkazib beruvchi) qarzi shu summadan (butun so'm) oshsa — istalgan
# yo'nalishda — bir martalik bildirishnoma yaratiladi. Bo'sh yoki 0 bo'lsa,
# bu tekshiruv butunlay o'chiq.
DEBT_ALERT_THRESHOLD=""
